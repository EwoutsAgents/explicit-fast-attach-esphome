 #include <openthread/platform/misc.h>
 
 #include "openthread-system.h"
@@ -53,6 +56,51 @@
  */
 extern void otAppCliInit(otInstance *aInstance);
 
+#if OPENTHREAD_CONFIG_MLE_FAST_ATTACH_ENABLE && OPENTHREAD_CONFIG_MLE_FAST_ATTACH_AUTO_ARM_AFTER_DETACH_ENABLE && \
+    !OPENTHREAD_FTD
+static bool sFastAttachObservedAttached;
+static bool sFastAttachDetachHandled;
+
+static void HandleFastAttachStateChanged(otChangedFlags aFlags, void *aContext)
+{
+    otInstance   *instance = (otInstance *)aContext;
+    otDeviceRole  role;
+
+    if ((aFlags & OT_CHANGED_THREAD_ROLE) == 0)
+    {
+        return;
+    }
+
+    role = otThreadGetDeviceRole(instance);
+
+    if (role >= OT_DEVICE_ROLE_CHILD)
+    {
+        bool enabled = otThreadIsFastAttachEnabled(instance);
+
+        sFastAttachObservedAttached = true;
+        sFastAttachDetachHandled    = false;
+        otPlatLog(OT_LOG_LEVEL_NOTE, OT_LOG_REGION_API,
+                  "FAST_ATTACH event=attached_seen time_us=%lu role=%u enabled=%u",
+                  (unsigned long)otPlatAlarmMicroGetNow(), role, enabled);
+    }
+    else if ((role == OT_DEVICE_ROLE_DETACHED) && sFastAttachObservedAttached && !sFastAttachDetachHandled)
+    {
+        otError error;
+        bool    enabled;
+
+        otPlatLog(OT_LOG_LEVEL_NOTE, OT_LOG_REGION_API,
+                  "FAST_ATTACH event=detached_seen time_us=%lu role=%u",
+                  (unsigned long)otPlatAlarmMicroGetNow(), role);
+        error   = otThreadSetFastAttachEnabled(instance, true);
+        enabled = otThreadIsFastAttachEnabled(instance);
+        sFastAttachDetachHandled = true;
+        otPlatLog(OT_LOG_LEVEL_NOTE, OT_LOG_REGION_API,
+                  "FAST_ATTACH event=arm_after_detach time_us=%lu role=%u api_error=%u enabled=%u",
+                  (unsigned long)otPlatAlarmMicroGetNow(), role, error, enabled);
+    }
+}
+#endif
+
 #if OPENTHREAD_CONFIG_HEAP_EXTERNAL_ENABLE
 OT_TOOL_WEAK void *otPlatCAlloc(size_t aNum, size_t aSize) { return calloc(aNum, aSize); }
 
