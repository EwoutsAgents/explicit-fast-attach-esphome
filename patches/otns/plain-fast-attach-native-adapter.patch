     otAppCliInit(instance);
 
+#if OPENTHREAD_CONFIG_MLE_FAST_ATTACH_ENABLE && OPENTHREAD_CONFIG_MLE_FAST_ATTACH_AUTO_ARM_AFTER_DETACH_ENABLE && \
+    !OPENTHREAD_FTD
+    sFastAttachObservedAttached = false;
+    sFastAttachDetachHandled    = false;
+    assert(otSetStateChangedCallback(instance, HandleFastAttachStateChanged, instance) == OT_ERROR_NONE);
+#endif
+
 #if OPENTHREAD_POSIX && !defined(FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION)
     IgnoreError(otCliSetUserCommands(kCommands, OT_ARRAY_LENGTH(kCommands), instance));
